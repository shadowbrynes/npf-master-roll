  <div id="add-unit-modal" class="fixed inset-0 bg-black/85 z-50 flex items-center justify-center p-4 hidden no-print font-mono text-xs backdrop-blur-md">
    <div class="bg-slate-900 border border-teal-500/50 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <i data-lucide="layers" class="w-5 h-5 text-teal-400"></i>
          <h3 class="text-sm font-black text-teal-400 uppercase">ADD NEW UNIT</h3>
        </div>
        <button type="button" onclick="confirmCloseAddUnitModal()" class="text-slate-400 hover:text-white cursor-pointer"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div id="unit-modal-error" class="hidden p-3 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-300 text-xs font-bold"></div>

      <form id="form-create-unit" onsubmit="handleAddUnitSubmit(event)" class="space-y-4">
        <div>
          <label class="text-teal-400 block font-bold mb-1">UNIT CODE: *</label>
          <input type="text" id="unit-code" required placeholder="e.g. OPS-01" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-bold focus:border-teal-500 focus:outline-none">
          <span id="err-unit-code" class="text-[11px] text-rose-400 hidden mt-1"></span>
        </div>
        <div>
          <label class="text-white block font-bold mb-1">UNIT NAME: *</label>
          <input type="text" id="unit-name" required placeholder="e.g. OPERATIONS UNIT" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-bold focus:border-teal-500 focus:outline-none">
          <span id="err-unit-name" class="text-[11px] text-rose-400 hidden mt-1"></span>
        </div>
        <div>
          <label class="text-sky-400 block font-bold mb-1">PARENT BASE OR COMMAND: *</label>
          <select id="unit-base-id" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-bold focus:border-teal-500 focus:outline-none">
            <!-- INJECTED DYNAMICALLY -->
          </select>
        </div>
        <div>
          <label class="text-slate-300 block font-bold mb-1">DESCRIPTION:</label>
          <textarea id="unit-description" placeholder="Operational responsibilities and scope" rows="2" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-medium focus:border-teal-500 focus:outline-none"></textarea>
        </div>

        <div class="flex items-center justify-between gap-3 pt-2">
          <button type="button" onclick="confirmCloseAddUnitModal()" class="w-1/3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-3 rounded-xl uppercase transition cursor-pointer">CANCEL</button>
          <button type="submit" id="btn-submit-unit" class="w-2/3 bg-teal-600 hover:bg-teal-500 disabled:opacity-50 text-white font-black py-3 rounded-xl uppercase transition cursor-pointer flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(20,184,166,0.3)]">
            <span id="btn-submit-unit-text">SAVE UNIT</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div id="add-base-modal" class="fixed inset-0 bg-black/85 z-50 flex items-center justify-center p-4 hidden no-print font-mono text-xs backdrop-blur-md">
    <div class="bg-slate-900 border border-sky-500/50 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <i data-lucide="building-2" class="w-5 h-5 text-sky-400"></i>
          <h3 class="text-sm font-black text-sky-400 uppercase">ADD NEW BASE</h3>
        </div>
        <button type="button" onclick="confirmCloseAddBaseModal()" class="text-slate-400 hover:text-white cursor-pointer"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div id="base-modal-error" class="hidden p-3 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-300 text-xs font-bold"></div>

      <form id="form-create-base" onsubmit="handleAddBaseSubmit(event)" class="space-y-4">
        <div>
          <label class="text-sky-400 block font-bold mb-1">BASE CODE: *</label>
          <input type="text" id="base-code" required placeholder="e.g. BASE 38" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-bold focus:border-sky-500 focus:outline-none">
          <span id="err-base-code" class="text-[11px] text-rose-400 hidden mt-1"></span>
        </div>
        <div>
          <label class="text-white block font-bold mb-1">BASE NAME: *</label>
          <input type="text" id="base-name" required placeholder="e.g. UYO, AKWA IBOM STATE" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-white font-bold focus:border-sky-500 focus:outline-none">
          <span id="err-base-name" class="text-[11px] text-rose-400 hidden mt-1"></span>
        </div>

        <div class="flex items-center justify-between gap-3 pt-2">
          <button type="button" onclick="confirmCloseAddBaseModal()" class="w-1/3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold py-3 rounded-xl uppercase transition cursor-pointer">CANCEL</button>
          <button type="submit" id="btn-submit-base" class="w-2/3 bg-sky-600 hover:bg-sky-500 disabled:opacity-50 text-white font-black py-3 rounded-xl uppercase transition cursor-pointer flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(14,165,233,0.3)]">
            <span id="btn-submit-base-text">SAVE BASE</span>
          </button>
        </div>
      </form>
