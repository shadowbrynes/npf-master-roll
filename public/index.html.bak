        <div><label class="text-white block font-bold">FULL NAME:</label><input type="text" id="reg-fullname" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white"></div>
        <div><label class="text-cyan-400 block font-bold">EMAIL:</label><input type="email" id="reg-email" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-white"></div>
