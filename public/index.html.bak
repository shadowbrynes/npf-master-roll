<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>EOD-CBRN Command National Personnel Directory | EOD-CBRN COMMAND NOMINAL ROLL</title>
  
  <!-- TAILWIND CSS, LUCIDE ICONS & SHEETJS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#22c55e',
              600: '#16a34a',
              900: '#14532d',
              950: '#052e16',
            }
          }
        }
      }
    }
  </script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700;800&display=swap');
    body {
      font-family: 'Inter', sans-serif;
      background-color: #020617;
      color: #f8fafc;
      overflow-x: hidden;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #090d16;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }
    .hero-image-glow {
      box-shadow: 0 0 30px rgba(16, 185, 129, 0.25), 0 0 10px rgba(6, 182, 212, 0.2);
    }
  </style>
<script>
        async function handleRegistrationSubmit(event) {
          if (event) event.preventDefault();
          const nameInput = document.getElementById('reg-name') || document.getElementById('register-name');
          const emailInput = document.getElementById('reg-email') || document.getElementById('register-email');
          const passInput = document.getElementById('reg-password') || document.getElementById('register-password');
          const confirmPassInput = document.getElementById('reg-confirm-password') || document.getElementById('register-confirm-password');
          const apfInput = document.getElementById('reg-apf-no') || document.getElementById('register-apf-no');
          const btn = document.getElementById('btn-register-submit') || document.querySelector('#register-modal button[type="submit"]');

          if (!emailInput || !passInput) return;

          const fullName = nameInput ? nameInput.value.trim() : '';
          const email = emailInput.value.trim();
          const password = passInput.value;
          const confirmPassword = confirmPassInput ? confirmPassInput.value : '';
          const apfNo = apfInput ? apfInput.value.trim() : '';

          if (btn) {
            btn.disabled = true;
            btn.dataset.origText = btn.innerText;
            btn.innerText = 'Registering...';
          }

          try {
            const resp = await fetch('/api/register', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ fullName, email, password, confirmPassword, apfNo })
            });

            const resData = await resp.json();
            if (resp.ok && resData.success) {
              if (typeof showToast === 'function') showToast('Registration successful! You can now sign in.', 'success');
              const modal = document.getElementById('register-modal');
              if (modal) modal.classList.add('hidden');
              if (event.target && typeof event.target.reset === 'function') event.target.reset();
            } else {
              const errMsg = resData.message || (resData.errors ? Object.values(resData.errors).join(' ') : 'Registration failed.');
              if (typeof showToast === 'function') showToast(errMsg, 'error');
              else alert(errMsg);
            }
          } catch (err) {
            console.error('Registration Exception:', err);
            if (typeof showToast === 'function') showToast('Network error during registration.', 'error');
          } finally {
            if (btn) {
              btn.disabled = false;
              btn.innerText = btn.dataset.origText || 'Register Account';
            }
          }
        }
        </script>

    <script>
    async function handleCreateBaseSubmit(e) {
      if (e) e.preventDefault();
      const codeEl = document.getElementById('base-code') || document.getElementById('form-baseCode');
      const nameEl = document.getElementById('base-name') || document.getElementById('form-baseName');
      const submitBtn = document.getElementById('btn-submit-base') || document.getElementById('btn-save-base');

      const baseCode = codeEl ? codeEl.value.trim() : '';
      const baseName = nameEl ? nameEl.value.trim() : '';

      if (!baseCode || !baseName) {
        if (typeof showToast === 'function') showToast('Base Code and Base Name are required.', 'error');
        else alert('Base Code and Base Name are required.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.origText = submitBtn.innerText;
        submitBtn.innerText = 'Saving Base...';
      }

      try {
        const res = await fetch('/api/bases', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-user-role': 'GLOBAL_ADMIN' },
          body: JSON.stringify({ baseCode, baseName })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (typeof showToast === 'function') showToast('Base added successfully!', 'success');
          await fetchBasesFromAPI();
          const modal = document.getElementById('add-base-modal') || document.getElementById('modal-create-base');
          if (modal) modal.classList.add('hidden');
          if (e.target && typeof e.target.reset === 'function') e.target.reset();
        } else {
          const errMsg = data.message || (data.errors ? Object.values(data.errors).join(' ') : 'Base creation failed.');
          if (typeof showToast === 'function') showToast(errMsg, 'error');
          else alert(errMsg);
        }
      } catch (err) {
        console.error('Base creation exception:', err);
        if (typeof showToast === 'function') showToast('Network error while saving base.', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = submitBtn.dataset.origText || 'Save Base';
        }
      }
    }

    async function handleCreateUnitSubmit(e) {
      if (e) e.preventDefault();
      const codeEl = document.getElementById('unit-code') || document.getElementById('form-unitCode');
      const nameEl = document.getElementById('unit-name') || document.getElementById('form-unitName');
      const baseSelect = document.getElementById('unit-base-id') || document.getElementById('ap-base-id');
      const submitBtn = document.getElementById('btn-submit-unit') || document.getElementById('btn-save-unit');

      const unitCode = codeEl ? codeEl.value.trim() : '';
      const unitName = nameEl ? nameEl.value.trim() : '';
      const baseId = baseSelect ? baseSelect.value : '';

      if (!unitCode || !unitName || !baseId) {
        if (typeof showToast === 'function') showToast('Unit Code, Unit Name, and Parent Base are required.', 'error');
        else alert('Unit Code, Unit Name, and Parent Base are required.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.origText = submitBtn.innerText;
        submitBtn.innerText = 'Saving Unit...';
      }

      try {
        const res = await fetch('/api/units', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-user-role': 'GLOBAL_ADMIN' },
          body: JSON.stringify({ unitCode, unitName, baseId })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (typeof showToast === 'function') showToast('Unit added successfully!', 'success');
          await fetchUnitsFromAPI();
          const modal = document.getElementById('add-unit-modal') || document.getElementById('modal-create-unit');
          if (modal) modal.classList.add('hidden');
          if (e.target && typeof e.target.reset === 'function') e.target.reset();
        } else {
          const errMsg = data.message || (data.errors ? Object.values(data.errors).join(' ') : 'Unit creation failed.');
          if (typeof showToast === 'function') showToast(errMsg, 'error');
          else alert(errMsg);
        }
      } catch (err) {
        console.error('Unit creation exception:', err);
        if (typeof showToast === 'function') showToast('Network error while saving unit.', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = submitBtn.dataset.origText || 'Save Unit';
        }
      }
    }
    </script>
    
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-emerald-500 selection:text-black">

  <!-- TOP HIGH-THREAT COMMAND HEADER -->
  <header class="bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800 sticky top-0 z-40 shadow-2xl no-print">
    <div class="max-w-[1700px] mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
      
      <!-- LOGO & TITLE -->
      <div class="flex items-center gap-3.5 cursor-pointer" onclick="switchView('ROLL_ALL')">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-600 via-emerald-500 to-teal-400 p-0.5 shadow-[0_0_20px_rgba(16,185,129,0.3)]">
          <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
            <i data-lucide="shield-alert" class="w-6 h-6 text-emerald-400"></i>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base font-black text-white tracking-wider uppercase font-mono">EOD-CBRN COMMAND NATIONAL DIRECTORY</h1>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-black bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">EOD-CBRN COMMAND NOMINAL ROLL</span>
          </div>
          <p class="text-xs text-slate-400 font-mono">AUTHORISED NIGERIA POLICE EOD-CBRN PERSONNEL MASTER ROLL</p>
        </div>
      </div>

      <!-- HEADER ACTION CONTROLS -->
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
        
        <!-- FIRESTORE SYNC STATUS -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-[11px] font-bold">CLOUD SYNC: ONLINE</span>
        </div>

        <!-- ROLE SELECTOR -->
        <div class="flex items-center gap-1.5 bg-slate-900 border border-amber-500/40 px-3 py-1.5 rounded-xl">
          <i data-lucide="shield-check" class="w-4 h-4 text-amber-400"></i>
          <span class="text-slate-400 text-[11px] font-bold">ROLE:</span>
          <select id="user-role-selector" onchange="changeUserRole(this.value)" class="bg-slate-950 text-amber-300 font-black text-xs border border-slate-800 rounded-lg px-2 py-0.5 focus:outline-none cursor-pointer">
            <option value="GLOBAL_ADMIN">GLOBAL_ADMIN (Global Administrator - Sole Write Role)</option>
            <option value="RECORDS_ADMIN">RECORDS_ADMIN (Records Administrator - Read Only)</option>
            <option value="COMMANDER">COMMANDER (Command Head - Read Only Base Scope)</option>
            <option value="PERSONNEL">PERSONNEL (Self-Service Officer - Read Only Own Profile)</option>
          </select>
        </div>

        <!-- PART 3: PROMINENT RESTORED ADD PERSONNEL BUTTON (GLOBAL ADMIN ONLY) -->
        <button id="btn-nav-add-personnel" onclick="openAddPersonnelModal()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-black font-black px-4 py-2 rounded-xl text-xs flex items-center gap-2 shadow-[0_0_20px_rgba(16,185,129,0.4)] transition cursor-pointer uppercase tracking-wider">
          <i data-lucide="user-plus" class="w-4.5 h-4.5 text-black"></i>
          <span>ADD PERSONNEL</span>
        </button>

        <!-- RECONCILIATION REPORT BUTTON -->
        <button onclick="openReconciliationModal()" class="bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/40 font-bold px-3 py-2 rounded-xl text-xs flex items-center gap-1.5 transition cursor-pointer font-mono">
          <i data-lucide="file-check" class="w-3.5 h-3.5 text-cyan-400"></i>
          <span>RECONCILIATION REPORT</span>
        </button>

        <!-- PUBLIC PERSONNEL LOGIN BUTTON -->
        <button id="btn-public-login" onclick="openPersonnelLoginModal()" class="bg-cyan-600 hover:bg-cyan-500 text-white font-black px-3.5 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow-[0_0_15px_rgba(6,182,212,0.3)] transition cursor-pointer uppercase tracking-wider">
          <i data-lucide="key-round" class="w-4 h-4 text-white"></i>
          <span>LOGIN</span>
        </button>

        <!-- PUBLIC PERSONNEL REGISTRATION BUTTON -->
        <button id="btn-public-register" onclick="openPersonnelRegisterModal()" class="bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/40 font-black px-3.5 py-2 rounded-xl text-xs flex items-center gap-1.5 transition cursor-pointer uppercase tracking-wider">
          <i data-lucide="user-check" class="w-4 h-4 text-cyan-400"></i>
          <span>REGISTER</span>
        </button>

        <!-- ROLLBACK EOD APAPA REPLACEMENT BUTTON -->
        <button id="btn-rollback-apapa" onclick="rollbackApapaMasterRollReplacement()" class="bg-rose-950 hover:bg-rose-900 text-rose-300 border border-rose-500/40 font-bold px-3 py-2 rounded-xl text-xs flex items-center gap-1.5 transition cursor-pointer font-mono">
          <i data-lucide="undo-2" class="w-3.5 h-3.5 text-rose-400"></i>
          <span>ROLLBACK IMPORT</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-[1700px] w-full mx-auto p-4 sm:p-6 space-y-6">

    <!-- READ ONLY ACCESS WARNING FOR NON-ADMINS -->
    <div id="read-only-notice-banner" class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-3.5 flex items-center justify-between gap-3 text-xs font-mono text-amber-300 hidden no-print">
      <div class="flex items-center gap-2">
        <i data-lucide="lock" class="w-4 h-4 text-amber-400"></i>
        <span><strong>READ-ONLY ACCESS ENFORCED:</strong> Only the Global Administrator (GLOBAL_ADMIN) can add, edit, or modify personnel records.</span>
      </div>
    </div>

    <!-- DASHBOARD HERO SECTION -->
    <section id="dashboard-hero-section" class="relative bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 overflow-hidden shadow-2xl no-print">
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-7 space-y-5 font-mono">
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[11px] font-black uppercase">
              DATASET AUTHORITATIVE: Supabase Production PostgreSQL Database
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white uppercase">EOD CBRN COMMAND</h1>
          <p class="text-sm font-extrabold text-emerald-400 uppercase">AUTHORISED NIGERIA POLICE EOD CBRN APAPA FORMATION MASTER ROLL</p>
          <p class="text-xs text-slate-300 font-sans leading-relaxed">
            Dataset synchronized directly from Supabase PostgreSQL database.<strong class="text-emerald-400 font-mono">Initial Dataset Imported into Supabase</strong>. Displaying full 26 nominal roll headings with statutory retirement dates.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button id="btn-hero-add-personnel" onclick="openAddPersonnelModal()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-black font-black px-5 py-3 rounded-xl text-xs flex items-center gap-2 shadow-[0_0_20px_rgba(16,185,129,0.4)] transition cursor-pointer uppercase tracking-wider">
              <i data-lucide="user-plus" class="w-4.5 h-4.5 text-black"></i>
              <span>ADD PERSONNEL</span>
            </button>
            <button onclick="openReconciliationModal()" class="bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/40 font-black px-5 py-3 rounded-xl text-xs flex items-center gap-2 transition cursor-pointer uppercase tracking-wider">
              <i data-lucide="file-check" class="w-4.5 h-4.5 text-cyan-400"></i>
              <span>RECONCILIATION REPORT</span>
            </button>
            <button onclick="openAddCommanderModal()" class="bg-amber-600 hover:bg-amber-500 text-black font-black px-5 py-3 rounded-xl text-xs flex items-center gap-2 transition cursor-pointer uppercase tracking-wider">
              <i data-lucide="crown" class="w-4.5 h-4.5 text-black"></i>
              <span>COMMANDERS</span>
            </button>
          </div>
        </div>
        <div class="lg:col-span-5 w-full flex justify-center">
          <div class="relative w-full h-[280px] sm:h-[340px] rounded-3xl overflow-hidden border-2 border-emerald-500/40 bg-slate-950 shadow-2xl">
            <img src="/images/eod-dashboard-hero.webp" alt="Dashboard Hero" class="w-full h-full object-cover">
          </div>
        </div>
      </div>
    </section>

    <!-- DASHBOARD NAVIGATION CARDS -->
    <div id="dashboard-nav-grid" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-10 gap-2.5 font-mono text-xs no-print">
      <div onclick="switchView('ROLL_ALL')" id="card-ROLL_ALL" class="nav-card bg-slate-900 hover:bg-slate-850 border-2 border-emerald-500 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-emerald-400"><i data-lucide="layers" class="w-4 h-4"></i><span id="badge-count-all" class="font-black text-sm">24</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-emerald-400 transition">ALL MASTER ROLL</div>
        <div class="text-[9px] text-slate-400">Apapa Nominal Roll</div>
      </div>

      <div onclick="openAddPersonnelModal()" id="card-ADD_PERSONNEL" class="nav-card bg-slate-900 hover:bg-slate-850 border border-emerald-500/40 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-emerald-400"><i data-lucide="user-plus" class="w-4 h-4"></i><span class="font-black text-xs">+ ADD</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-emerald-400 transition">ADD PERSONNEL</div>
        <div class="text-[9px] text-slate-400">26 Headings Form</div>
      </div>

      <div onclick="switchView('ROLL_CP_DSP')" id="card-ROLL_CP_DSP" class="nav-card bg-slate-900 hover:bg-slate-850 border border-slate-800 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-amber-300"><i data-lucide="award" class="w-4 h-4"></i><span id="badge-count-cp-dsp" class="font-black text-sm">3</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-amber-300 transition">CP TO DSP</div>
        <div class="text-[9px] text-slate-400">Senior Officers</div>
      </div>

      <div onclick="switchView('ROLL_ASP_INSP')" id="card-ROLL_ASP_INSP" class="nav-card bg-slate-900 hover:bg-slate-850 border border-slate-800 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-emerald-400"><i data-lucide="shield-check" class="w-4 h-4"></i><span id="badge-count-asp-insp" class="font-black text-sm">20</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-emerald-400 transition">ASP TO INSP</div>
        <div class="text-[9px] text-slate-400">Inspectors Cadre</div>
      </div>

      <div onclick="switchView('ROLL_SGT_PC')" id="card-ROLL_SGT_PC" class="nav-card bg-slate-900 hover:bg-slate-850 border border-slate-800 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-sky-400"><i data-lucide="users" class="w-4 h-4"></i><span id="badge-count-sgt-pc" class="font-black text-sm">1</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-sky-400 transition">SGT TO PC</div>
        <div class="text-[9px] text-slate-400">Rank & File</div>
      </div>

      <div onclick="openPersonnelLoginModal()" class="nav-card bg-slate-900 hover:bg-slate-850 border border-slate-800 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-cyan-400"><i data-lucide="key-round" class="w-4 h-4"></i><span class="font-black text-xs">PORTAL</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-cyan-400 transition">LOGIN</div>
        <div class="text-[9px] text-slate-400">Self-Service</div>
      </div>

      <div onclick="openPersonnelRegisterModal()" class="nav-card bg-slate-900 hover:bg-slate-850 border border-slate-800 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-cyan-300"><i data-lucide="user-check" class="w-4 h-4"></i><span class="font-black text-xs">SELF-REG</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-cyan-300 transition">REGISTER</div>
        <div class="text-[9px] text-slate-400">New Applicant</div>
      </div>

      <div onclick="openAddCommanderModal()" class="nav-card bg-slate-900 hover:bg-slate-850 border border-amber-500/40 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-amber-400"><i data-lucide="crown" class="w-4 h-4"></i><span id="badge-count-commanders" class="font-black text-sm">1</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-amber-400 transition">COMMANDERS</div>
        <div class="text-[9px] text-slate-400">Add / Appoint</div>
      </div>

      
      <div onclick="openAddUnitModal()" class="nav-card bg-slate-900 hover:bg-slate-850 border border-teal-500/40 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-teal-400"><i data-lucide="layers" class="w-4 h-4"></i><span id="badge-count-units" class="font-black text-sm">2</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-teal-400 transition">ADD UNIT</div>
        <div class="text-[9px] text-slate-400">Command Sub-Unit</div>
      </div>
      <div onclick="openAddBaseModal()" class="nav-card bg-slate-900 hover:bg-slate-850 border border-sky-500/40 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-sky-400"><i data-lucide="building-2" class="w-4 h-4"></i><span id="badge-count-bases" class="font-black text-sm">2</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-sky-400 transition">ADD BASE</div>
        <div class="text-[9px] text-slate-400">Add Base</div>
      </div>

      <div onclick="switchView('RETIREMENT_DASHBOARD')" id="card-RETIREMENT_DASHBOARD" class="nav-card bg-slate-900 hover:bg-slate-850 border border-slate-800 p-3 rounded-2xl cursor-pointer transition shadow-lg space-y-1 group">
        <div class="flex justify-between items-center text-amber-400"><i data-lucide="calendar" class="w-4 h-4"></i><span id="badge-count-approaching" class="font-black text-sm">0</span></div>
        <div class="font-black text-white uppercase text-[10px] tracking-wider group-hover:text-amber-400 transition">RETIREMENTS</div>
        <div class="text-[9px] text-slate-400">2-Month Notice</div>
      </div>
    </div>

    <!-- DYNAMIC MODULE CONTAINER -->
    <div id="module-container" class="space-y-6"></div>

  </main>

  <!-- ========================================================================= -->
  <!-- MODAL 1: PART 3 & 4 & 5 - RESTORED ADD PERSONNEL MODAL (26 HEADINGS) -->
  <!-- ========================================================================= -->
  <div id="add-personnel-modal" class="fixed inset-0 bg-black/85 z-50 flex items-center justify-center p-4 hidden no-print overflow-y-auto backdrop-blur-md font-mono text-xs">
    <div class="bg-slate-900 border border-emerald-500/50 rounded-2xl max-w-4xl w-full p-6 space-y-5 my-8 shadow-2xl max-h-[90vh] flex flex-col">
      <div class="flex justify-between items-center border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <i data-lucide="user-plus" class="w-5 h-5 text-emerald-400"></i>
          <h3 class="text-sm font-black text-white uppercase tracking-wider">ADD PERSONNEL TO MASTER ROLL (26 HEADINGS)</h3>
        </div>
        <button onclick="closeAddPersonnelModal()" class="text-slate-400 hover:text-white cursor-pointer"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <form onsubmit="handleAddPersonnelSubmit(event)" class="space-y-6 overflow-y-auto pr-1">
        
        <!-- SECTION A: PERSONAL AND CONTACT INFORMATION -->
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
          <h4 class="text-xs font-black text-emerald-400 uppercase border-b border-slate-800 pb-2">SECTION A: PERSONAL AND CONTACT INFORMATION</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <div><label class="text-emerald-400 block font-bold">1. AP/F/NO: *</label><input type="text" id="ap-serviceno" required placeholder="AP/117369" class="w-full bg-slate-900 border border-slate-800 text-white font-bold rounded-xl px-3 py-2 focus:border-emerald-500 focus:outline-none"></div>
            <div><label class="text-amber-300 block font-bold">2. RANK: *</label><select id="ap-rank" required class="w-full bg-slate-900 border border-slate-800 text-amber-300 font-bold rounded-xl px-3 py-2 text-xs focus:border-emerald-500 focus:outline-none"><option value="CSP">CSP</option><option value="SP">SP</option><option value="DSP">DSP</option><option value="ASP I">ASP I</option><option value="ASP II">ASP II</option><option value="INSPR">INSPR</option><option value="SGT">SGT</option><option value="CPL">CPL</option><option value="PC">PC</option></select></div>
            <div class="sm:col-span-2"><label class="text-white block font-bold">3. NAME: *</label><input type="text" id="ap-name" required placeholder="DESMOND AGBALA" class="w-full bg-slate-900 border border-slate-800 text-white font-bold rounded-xl px-3 py-2 focus:border-emerald-500 focus:outline-none"></div>
            <div><label class="text-slate-300 block font-bold">4. EDU. QUALIFICATION:</label><input type="text" id="ap-edu" placeholder="BSC POLICE SCIENCE" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">5. STATE OF ORIGIN: *</label><input type="text" id="ap-state" required placeholder="EDO" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-emerald-400 block font-bold">6. PHONE NUMBER: *</label><input type="text" id="ap-phone" required placeholder="08034268620" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">7. TRIBE:</label><input type="text" id="ap-tribe" placeholder="ORAH" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">8. DATE OF BIRTH: *</label><input type="date" id="ap-dob" required class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">9. GEO POL ZONE:</label><input type="text" id="ap-zone" placeholder="SOUTH SOUTH" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-cyan-400 block font-bold">10. E-MAIL ADDRESS:</label><input type="email" id="ap-email" placeholder="officer@npf.gov.ng" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">11. MSS:</label><input type="text" id="ap-mss" placeholder="APAPA BASE LAGOS" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
          </div>
        </div>

        <!-- SECTION B: CAREER, DEPLOYMENT AND RETIREMENT -->
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
          <h4 class="text-xs font-black text-amber-400 uppercase border-b border-slate-800 pb-2">SECTION B: CAREER, DEPLOYMENT AND RETIREMENT</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <div><label class="text-slate-300 block font-bold">12. DATE OF ENLIST: *</label><input type="date" id="ap-enlist" required class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">13. DATE OF LAST PROM.:</label><input type="date" id="ap-lastprom" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-amber-400 block font-bold">14. DATE OF RETIREMENT:</label><input type="date" id="ap-retire" readonly placeholder="Auto-calculated" class="w-full bg-slate-950 border border-slate-800 text-amber-300 font-bold rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">15. COMMAND SERVED LAST:</label><input type="text" id="ap-lastcommand" placeholder="APAPA SEA PORT EOD BASE" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">16. DUTY POST:</label><input type="text" id="ap-duty" placeholder="EOD OPERATIVE" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">17. DATE TRANSFERRED:</label><input type="date" id="ap-transferdate" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">18. GD/SP:</label><input type="text" id="ap-gdsp" placeholder="EOD TECH" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
          </div>
        </div>

        <!-- SECTION C: FINANCIAL, PAYROLL AND PENSION -->
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
          <h4 class="text-xs font-black text-cyan-400 uppercase border-b border-slate-800 pb-2">SECTION C: FINANCIAL, PAYROLL AND PENSION (GLOBAL ADMIN RESTRICTED)</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <div><label class="text-slate-300 block font-bold">19. G/L:</label><input type="text" id="ap-gl" placeholder="10" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">20. BANK NAME:</label><input type="text" id="ap-bank" placeholder="POLICE MORTGAGE BANK" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">21. EMPLOYEE CODE:</label><input type="text" id="ap-empcode" placeholder="PF012964" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-emerald-400 block font-bold">22. IPPIS NUMBER:</label><input type="text" id="ap-ippis" placeholder="100060086275" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">23. PFA:</label><input type="text" id="ap-pfa" placeholder="NPF PENSION" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">24. PEN PIN:</label><input type="text" id="ap-penpin" placeholder="131696142-8" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
            <div><label class="text-slate-300 block font-bold">25. NHF NUMBER:</label><input type="text" id="ap-nhf" placeholder="NHF-117369" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-3 py-2"></div>
          </div>
        </div>

        <!-- SECTION D: BASE OR UNIT ASSIGNMENT -->
          <div>
            <label class="text-teal-400 block font-bold">26. ASSIGNED UNIT: *</label>
            <select id="ap-unit-id" required class="w-full bg-slate-900 border border-slate-800 text-white font-bold rounded-xl px-3 py-2 text-xs focus:border-teal-500 focus:outline-none">
              <!-- INJECTED DYNAMICALLY -->
            </select>
          </div>
        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3">
          <h4 class="text-xs font-black text-sky-400 uppercase border-b border-slate-800 pb-2">SECTION D: VERIFIED BASE OR UNIT ASSIGNMENT</h4>
          <div>
            <label class="text-sky-400 block font-bold">SELECT VERIFIED BASE OR UNIT: *</label>
            <select id="ap-base-id" onchange="filterUnitsBySelectedBase(this.value)" required class="w-full bg-slate-900 border border-slate-800 text-white font-bold rounded-xl px-3 py-2 text-xs focus:border-sky-500 focus:outline-none">
              <!-- INJECTED DYNAMICALLY -->
            </select>
          </div>
        </div>

        <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-black py-3.5 rounded-xl text-xs transition cursor-pointer uppercase tracking-wider shadow-[0_0_20px_rgba(16,185,129,0.4)]">
          SAVE PERSONNEL RECORD TO MASTER ROLL
        </button>
      </form>
    </div>
  </div>

  <!-- RECONCILIATION REPORT MODAL -->
  <div id="reconciliation-modal" class="fixed inset-0 bg-black/85 z-50 flex items-center justify-center p-4 hidden no-print font-mono text-xs backdrop-blur-md">
