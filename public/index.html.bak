    var dbPersonnel = JSON.parse(JSON.stringify(INITIAL_APAPA_PERSONNEL));
    var archivedMasterRolls = [JSON.parse(JSON.stringify(INITIAL_APAPA_PERSONNEL))];
    var auditLogs = [];
    var registrationRequests = [];

    var basesUnits = [
      {
        baseUnitId: 'EOD-HQ-ABUJA',
        baseUnitCode: 'EOD-HQ-00',
        baseUnitName: 'National EOD-CBRN Command Headquarters, Abuja',
        baseUnitType: 'NATIONAL_HEADQUARTERS',
        parentBaseUnitId: 'ROOT',
        state: 'FCT ABUJA',
        status: 'ACTIVE'
      },
      {
        baseUnitId: 'EOD-BASE-LAGOS',
        baseUnitCode: 'EOD-BASE-01',
        baseUnitName: 'Apapa Sea Port EOD-CBRN Tactical Base',
        baseUnitType: 'BASE',
        parentBaseUnitId: 'EOD-HQ-ABUJA',
        state: 'LAGOS',
        status: 'ACTIVE'
      }
    ];

    var currentView = 'ROLL_ALL';
    var currentUserRole = 'GLOBAL_ADMIN';

    function computeRankGroup(rank) {
      const r = (rank || '').toString().toUpperCase().trim();
      if (['CP', 'DCP', 'ACP', 'CSP', 'SP', 'DSP'].includes(r)) return 'CP_TO_DSP';
      if (['ASP I', 'ASP II', 'ASP 1', 'ASP 2', 'ASP', 'INSP', 'INSPR', 'INSPECTOR'].includes(r)) return 'ASP_TO_INSPECTOR';
      if (['SGT', 'SERGEANT', 'CPL', 'CORPORAL', 'PC', 'CONSTABLE'].includes(r)) return 'SGT_TO_PC';
      return 'CP_TO_DSP';
    }

    function logAuditEvent(action, resourceType, resourceId, details) {
      auditLogs.unshift({
        auditId: 'AUD-' + Date.now(),
        actorRole: currentUserRole,
        action, resourceType, resourceId, details,
        timestamp: new Date().toISOString()
      });
    }

    function changeUserRole(role) {
      currentUserRole = role;
      if (role === 'GLOBAL_ADMIN') switchView('ROLL_ALL');
      else if (role === 'COMMANDER') switchView('ROLL_ALL');
      else if (role === 'PERSONNEL') switchView('SELF_SERVICE');
      else switchView('ROLL_ALL');
    }

    function switchView(viewName) {
      if (currentUserRole === 'PERSONNEL' && viewName !== 'SELF_SERVICE') {
        alert("403 ACCESS DENIED: Personnel users are restricted to their self-service portal.");
        currentView = 'SELF_SERVICE';
        renderModule();
        return;
      }
      currentView = viewName;
      renderModule();
    }

    function renderModule() {
      const container = document.getElementById('module-container');
      if (!container) return;
      container.innerHTML = '';

      if (currentView === 'SELF_SERVICE') {
        container.innerHTML = `<div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl font-mono text-xs text-cyan-300 font-black">OFFICER SELF-SERVICE PORTAL ACTIVE</div>`;
      } else {
        renderMasterRollTable(container);
      }
      if (window.lucide) window.lucide.createIcons();
    }

    function renderMasterRollTable(container) {
      let list = dbPersonnel;
      if (currentView === 'ROLL_CP_DSP') list = dbPersonnel.filter(p => computeRankGroup(p.rank) === 'CP_TO_DSP');
      if (currentView === 'ROLL_ASP_INSP') list = dbPersonnel.filter(p => computeRankGroup(p.rank) === 'ASP_TO_INSPECTOR');
      if (currentView === 'ROLL_SGT_PC') list = dbPersonnel.filter(p => computeRankGroup(p.rank) === 'SGT_TO_PC');

      container.innerHTML = `
        <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden font-mono text-xs">
          <div class="p-4 bg-slate-950 border-b border-slate-800 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <i data-lucide="layers" class="w-4.5 h-4.5 text-emerald-400"></i>
              <h3 class="text-sm font-black text-white uppercase tracking-wider">EOD-CBRN COMMAND NOMINAL ROLL MASTER ROLL (${list.length} RECORDS)</h3>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="openReconciliationModal()" class="bg-slate-900 hover:bg-slate-800 text-cyan-300 border border-cyan-500/40 px-3 py-1.5 rounded-xl font-bold">RECONCILIATION</button>
              <input type="text" id="table-search" onkeyup="filterMasterRollTable()" placeholder="Search name, AP/F/NO, rank..." class="bg-slate-900 border border-slate-800 text-white rounded-xl px-3 py-1.5 text-xs focus:outline-none">
              <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-xl font-bold border border-slate-700 cursor-pointer">PRINT</button>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap text-xs">
              <thead class="bg-slate-950 text-slate-300 border-b border-slate-800 uppercase font-black text-[11px]">
                <tr>
                  <th class="p-3 border-r border-slate-800 text-amber-400 text-center">1. S/NO</th>
                  <th class="p-3 border-r border-slate-800 text-emerald-400">2. AP/F/NO</th>
                  <th class="p-3 border-r border-slate-800 text-amber-300">3. RANK</th>
                  <th class="p-3 border-r border-slate-800 text-white">4. NAME</th>
                  <th class="p-3 border-r border-slate-800">5. EDU. QUALIFICATION</th>
                  <th class="p-3 border-r border-slate-800">6. STATE OF ORIGIN</th>
                  <th class="p-3 border-r border-slate-800 text-emerald-400">7. PHONE NUMBER</th>
                  <th class="p-3 border-r border-slate-800">8. TRIBE</th>
                  <th class="p-3 border-r border-slate-800">9. DATE OF BIRTH</th>
                  <th class="p-3 border-r border-slate-800">10. GEO POL ZONE</th>
                  <th class="p-3 border-r border-slate-800">11. DATE OF LAST PROM.</th>
                  <th class="p-3 border-r border-slate-800 text-amber-300">12. DATE OF RETIREMENT</th>
                  <th class="p-3 border-r border-slate-800 text-sky-400">13. COMMAND SERVED LAST</th>
                  <th class="p-3 border-r border-slate-800">14. DUTY POST</th>
                  <th class="p-3 border-r border-slate-800">15. DATE TRANSFERRED</th>
                  <th class="p-3 border-r border-slate-800">16. GD/SP</th>
                  <th class="p-3 border-r border-slate-800">17. DATE OF ENLIST</th>
                  <th class="p-3 border-r border-slate-800 text-cyan-400">18. E-MAIL ADDRESS</th>
                  <th class="p-3 border-r border-slate-800">19. G/L</th>
                  <th class="p-3 border-r border-slate-800 text-slate-400">20. BANK NAME</th>
                  <th class="p-3 border-r border-slate-800 text-slate-400">21. EMPLOYEE CODE</th>
                  <th class="p-3 border-r border-slate-800 text-emerald-400 font-mono">22. IPPIS NUMBER</th>
                  <th class="p-3 border-r border-slate-800 text-slate-400">23. PFA</th>
                  <th class="p-3 border-r border-slate-800 text-slate-400">24. PEN PIN</th>
                  <th class="p-3 border-r border-slate-800 text-slate-400">25. NHF NUMBER</th>
                  <th class="p-3">26. MSS</th>
                </tr>
              </thead>
              <tbody id="master-table-body" class="divide-y divide-slate-800 font-mono text-xs">
                ${list.map((p, i) => `
                  <tr class="hover:bg-slate-800/50">
                    <td class="p-3 border-r border-slate-800 font-black text-amber-400 text-center">${i + 1}</td>
                    <td class="p-3 border-r border-slate-800 font-black text-emerald-400">${p.apNo || p.serviceNo}</td>
                    <td class="p-3 border-r border-slate-800 font-bold text-amber-300">${p.rank}</td>
                    <td class="p-3 border-r border-slate-800 font-black text-white">${p.name}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.eduQual || 'BSC'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.stateOfOrigin || 'EDO'}</td>
                    <td class="p-3 border-r border-slate-800 text-emerald-400 font-bold">${p.phone || '08034268620'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.tribe || 'ORAH'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.dob || '1980-01-01'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.geoPolZone || 'SOUTH SOUTH'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.lastPromDate || '2020-01-01'}</td>
                    <td class="p-3 border-r border-slate-800 text-amber-300 font-bold">${p.retireDate || '2035-01-01'}</td>
                    <td class="p-3 border-r border-slate-800 text-sky-400 font-bold">${p.commandServedLast || 'Apapa EOD Base'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.dutyPost || 'EOD OPERATIVE'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.transferredDate || '2023-01-01'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.gdSp || 'EOD TECH'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.enlistDate || '2000-01-01'}</td>
                    <td class="p-3 border-r border-slate-800 text-cyan-400">${p.email || 'officer@npf.gov.ng'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-300">${p.gl || '10'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-400">${currentUserRole === 'GLOBAL_ADMIN' ? (p.bankName || 'POLICE MORTGAGE BANK') : '[RESTRICTED]'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-400">${currentUserRole === 'GLOBAL_ADMIN' ? (p.employeeCode || 'PF012964') : '[RESTRICTED]'}</td>
                    <td class="p-3 border-r border-slate-800 text-emerald-400 font-bold">${currentUserRole === 'GLOBAL_ADMIN' ? (p.ippisNo || '100060086275') : '[RESTRICTED]'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-400">${currentUserRole === 'GLOBAL_ADMIN' ? (p.pfa || 'NPF PENSION') : '[RESTRICTED]'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-400">${currentUserRole === 'GLOBAL_ADMIN' ? (p.penPin || '131696142-8') : '[RESTRICTED]'}</td>
                    <td class="p-3 border-r border-slate-800 text-slate-400">${currentUserRole === 'GLOBAL_ADMIN' ? (p.nhfNo || 'NHF-117369') : '[RESTRICTED]'}</td>
                    <td class="p-3 text-slate-300">${p.mss || 'APAPA BASE'}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function openReconciliationModal() {
      const modal = document.getElementById('reconciliation-modal');
      const tbody = document.getElementById('reconcil-table-body');
      if (tbody) {
        tbody.innerHTML = reconciliationReport.map(r => `
          <tr class="hover:bg-slate-800/50">
            <td class="p-2.5 border-r border-slate-800 text-amber-400 text-center font-bold">${r.sourceRowNumber}</td>
            <td class="p-2.5 border-r border-slate-800 text-emerald-400 font-bold">${r.sourceApNo}</td>
            <td class="p-2.5 border-r border-slate-800 text-white font-bold">${r.sourceName}</td>
            <td class="p-2.5 border-r border-slate-800 text-sky-400 font-bold">${r.importedApNo}</td>
            <td class="p-2.5 border-r border-slate-800 text-white font-bold">${r.importedName}</td>
            <td class="p-2.5 border-r border-slate-800"><span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold">${r.importStatus}</span></td>
          </tr>
        `).join('');
      }
      if (modal) modal.classList.remove('hidden');
    }

    function closeReconciliationModal() {
      const modal = document.getElementById('reconciliation-modal');
      if (modal) modal.classList.add('hidden');
    }

    function openAddPersonnelModal() {
      if (currentUserRole !== 'GLOBAL_ADMIN') {
        alert("403 ACCESS DENIED: Adding personnel is restricted exclusively to GLOBAL_ADMIN.");
        return;
      }
      populateBaseDropdowns();
      const modal = document.getElementById('add-personnel-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeAddPersonnelModal() {
      const modal = document.getElementById('add-personnel-modal');
      if (modal) modal.classList.add('hidden');
    }

    async function handleAddPersonnelSubmit(e) {
      if (e) e.preventDefault();

      const apNoEl = document.getElementById('ap-serviceno') || document.getElementById('form-apNo');
      const rankEl = document.getElementById('ap-rank') || document.getElementById('form-rank');
      const nameEl = document.getElementById('ap-name') || document.getElementById('form-name');
      const dobEl = document.getElementById('ap-dob') || document.getElementById('form-dob');
      const enlistDateEl = document.getElementById('ap-enlist') || document.getElementById('form-enlistDate');

      const apNo = apNoEl ? apNoEl.value.trim() : '';
      const rank = rankEl ? rankEl.value.trim() : 'INSPR';
      const name = nameEl ? nameEl.value.trim() : '';
      const dob = dobEl ? dobEl.value : '1985-01-01';
      const enlistDate = enlistDateEl ? enlistDateEl.value : '2005-01-01';
      const baseIdEl = document.getElementById('ap-base-id') || document.getElementById('unit-base-id');
      const baseId = baseIdEl ? baseIdEl.value : '';
      const unitIdEl = document.getElementById('ap-unit-id');
      const unitId = unitIdEl ? unitIdEl.value : '';

      if (!apNo || !name || !dob || !enlistDate) {
        alert('Please fill out all required fields (AP/F/NO, Rank, Name, DOB, Date of Enlistment).');
        return;
      }

      const submitBtn = document.getElementById('btn-submit-personnel') || document.querySelector('#personnel-form button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Saving to Database...';
      }

      const payload = {
        apfNo: apNo,
        rank: rank,
        fullName: name,
        dateOfBirth: dob,
        dateOfEnlistment: enlistDate,
        educationalQualification: (document.getElementById('ap-edu') ? document.getElementById('ap-edu').value : 'BSC POLICE SCIENCE'),
        stateOfOrigin: (document.getElementById('ap-state') ? document.getElementById('ap-state').value : 'EDO'),
        lga: (document.getElementById('ap-lga') ? document.getElementById('ap-lga').value : 'BENIN CITY'),
        tribe: (document.getElementById('ap-tribe') ? document.getElementById('ap-tribe').value : 'ORAH'),
        geopoliticalZone: (document.getElementById('ap-zone') ? document.getElementById('ap-zone').value : 'SOUTH SOUTH'),
        dateOfLastPromotion: (document.getElementById('ap-lastprom') ? document.getElementById('ap-lastprom').value : '2020-01-01'),
        retirementDate: (document.getElementById('ap-retire') ? document.getElementById('ap-retire').value : ''),
        commandServedLast: (document.getElementById('ap-lastcommand') ? document.getElementById('ap-lastcommand').value : 'NATIONAL COMMAND'),
        dateTransferredToCommand: (document.getElementById('ap-transferdate') ? document.getElementById('ap-transferdate').value : '2023-01-01'),
        gdSp: (document.getElementById('ap-gdsp') ? document.getElementById('ap-gdsp').value : 'EOD TECH'),
        gradeLevel: (document.getElementById('ap-gl') ? document.getElementById('ap-gl').value : '10'),
        dutyPost: (document.getElementById('ap-duty') ? document.getElementById('ap-duty').value : 'EOD OPERATIVE'),
        accountNumber: (document.getElementById('ap-account') ? document.getElementById('ap-account').value : ''),
        bankName: (document.getElementById('ap-bank') ? document.getElementById('ap-bank').value : 'POLICE MORTGAGE BANK'),
        employeeCode: (document.getElementById('ap-empcode') ? document.getElementById('ap-empcode').value : ''),
        ippisNumber: (document.getElementById('ap-ippis') ? document.getElementById('ap-ippis').value : ''),
        pfa: (document.getElementById('ap-pfa') ? document.getElementById('ap-pfa').value : 'NPF PENSION'),
        penPin: (document.getElementById('ap-penpin') ? document.getElementById('ap-penpin').value : ''),
        nhfNumber: (document.getElementById('ap-nhf') ? document.getElementById('ap-nhf').value : ''),
        mss: (document.getElementById('ap-mss') ? document.getElementById('ap-mss').value : 'APAPA BASE LAGOS'),
        emailAddress: (document.getElementById('ap-email') ? document.getElementById('ap-email').value : 'officer@npf.gov.ng'),
        phoneNumber: (document.getElementById('ap-phone') ? document.getElementById('ap-phone').value : '08034268620'),
        baseId: baseId || null,
        unitId: unitId || null
      };

      try {
        const res = await fetch('/api/personnel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-user-role': currentUserRole || 'GLOBAL_ADMIN' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert('Personnel record saved permanently to Supabase!');
          if (typeof fetchPersonnelFromAPI === 'function') await fetchPersonnelFromAPI();
          if (typeof closeAddPersonnelModal === 'function') closeAddPersonnelModal();
          if (e.target && typeof e.target.reset === 'function') e.target.reset();
        } else {
          const msg = data.message || (data.errors ? Object.values(data.errors).join(' ') : 'Failed to save personnel.');
          alert('Error saving personnel: ' + msg);
        }
      } catch (err) {
        console.error('Add Personnel API Exception:', err);
        alert('Network error saving personnel to database.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'SAVE PERSONNEL';
        }
      }
    }

    function rollbackApapaMasterRollReplacement() {
      if (currentUserRole !== 'GLOBAL_ADMIN') {
        alert("403 ACCESS DENIED: Rollback is restricted exclusively to GLOBAL_ADMIN.");
        return;
      }
      if (!confirm("Are you sure you want to roll back the EOD Apapa Master Roll replacement?")) return;

      if (archivedMasterRolls.length > 0) {
        dbPersonnel = JSON.parse(JSON.stringify(archivedMasterRolls[0]));
        alert("SUCCESS: Rolled back to previous Master Roll archive!");
        renderModule();
      } else {
        alert("No previous archive found to roll back.");
      }
    }

    function populateBaseDropdowns() {
      const options = basesUnits.map(b => `<option value="${b.baseUnitId}">${b.baseUnitName} (${b.baseUnitCode})</option>`).join('');
      ['ap-base-id'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.innerHTML = options;
      });
    }

    function openPersonnelLoginModal() { document.getElementById('personnel-login-modal').classList.remove('hidden'); }
    function closePersonnelLoginModal() { document.getElementById('personnel-login-modal').classList.add('hidden'); }
    function openPersonnelRegisterModal() { document.getElementById('personnel-register-modal').classList.remove('hidden'); }
    function closePersonnelRegisterModal() { document.getElementById('personnel-register-modal').classList.add('hidden'); }
    function openAddCommanderModal() { openAddPersonnelModal(); }
    function closeAddCommanderModal() { document.getElementById('add-commander-modal').classList.add('hidden'); }

    function handlePersonnelLoginSubmit(e) { e.preventDefault(); alert("Redirecting to Officer Portal..."); }
    function handlePersonnelRegisterSubmit(e) { e.preventDefault(); alert("Registration submitted!"); }
    
    
    function normalizeBaseCode(code) {
      return (code || '').toString().trim().replace(/\s+/g, ' ').toUpperCase();
    }

    function normalizeBaseName(name) {
      return (name || '').toString().trim().replace(/\s+/g, ' ').toUpperCase();
    }

    function openAddBaseModal() {
      if (currentUserRole !== 'GLOBAL_ADMIN' && currentUserRole !== 'SUPER_ADMIN' && currentUserRole !== 'RECORDS_ADMIN') {
        alert("403 ACCESS DENIED: You do not have permission to add a base.");
        return;
      }
      const modal = document.getElementById('add-base-modal');
      const errBanner = document.getElementById('base-modal-error');
      if (errBanner) { errBanner.classList.add('hidden'); errBanner.textContent = ''; }
      if (modal) modal.classList.remove('hidden');
    }

    function confirmCloseAddBaseModal() {
      const code = document.getElementById('base-code').value.trim();
      const name = document.getElementById('base-name').value.trim();
      if (code || name) {
        if (!confirm("Are you sure you want to cancel? Any unsaved base information will be lost.")) {
          return;
        }
      }
      closeAddBaseModal();
    }

    function closeAddBaseModal() {
      const modal = document.getElementById('add-base-modal');
      if (modal) modal.classList.add('hidden');
    }

    async function handleAddBaseSubmit(e) {
      if (e && e.preventDefault) e.preventDefault();

      const authorizedRoles = ['GLOBAL_ADMIN', 'SUPER_ADMIN', 'HR_ADMIN', 'RECORDS_ADMIN', 'SYSTEM_ADMINISTRATOR', 'PERSONNEL_ADMINISTRATOR'];
      if (!authorizedRoles.includes(currentUserRole)) {
        alert("You do not have permission to add a base.");
        return;
      }

      const codeInput = document.getElementById('base-code');
      const nameInput = document.getElementById('base-name');
      const submitBtn = document.getElementById('btn-submit-base');
      const submitBtnText = document.getElementById('btn-submit-base-text');
      const errBanner = document.getElementById('base-modal-error');
      const errCode = document.getElementById('err-base-code');
      const errName = document.getElementById('err-base-name');

      if (errBanner) { errBanner.classList.add('hidden'); errBanner.textContent = ''; }
      if (errCode) { errCode.classList.add('hidden'); errCode.textContent = ''; }
      if (errName) { errName.classList.add('hidden'); errName.textContent = ''; }
      codeInput.classList.remove('border-rose-500');
      nameInput.classList.remove('border-rose-500');

      const rawCode = codeInput.value;
      const rawName = nameInput.value;

      const normalizedCode = normalizeBaseCode(rawCode);
      const normalizedName = normalizeBaseName(rawName);

      let hasError = false;
      if (!normalizedCode) {
        if (errCode) { errCode.textContent = 'Base Code is required.'; errCode.classList.remove('hidden'); }
        codeInput.classList.add('border-rose-500');
        hasError = true;
      }
      if (!normalizedName) {
        if (errName) { errName.textContent = 'Base Name is required.'; errName.classList.remove('hidden'); }
        nameInput.classList.add('border-rose-500');
        hasError = true;
      }
      if (hasError) return;

      submitBtn.disabled = true;
      submitBtnText.textContent = 'Saving Base...';

      try {
        const response = await fetch('/api/bases', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-User-Role': currentUserRole
          },
          body: JSON.stringify({ baseCode: normalizedCode, baseName: normalizedName })
        });

        const contentType = response.headers.get('content-type') || '';
        let data = {};
        if (contentType.includes('application/json')) {
          data = await response.json();
        }

        if (response.status === 201 || (data && data.success)) {
          const createdRecord = data.data || {
            baseUnitId: 'EOD-BASE-' + Date.now(),
            baseCode: normalizedCode,
            baseName: normalizedName,
            status: 'ACTIVE'
          };

          const newBaseObj = {
            baseUnitId: createdRecord.id || createdRecord.baseUnitId || ('EOD-BASE-' + Date.now()),
            baseUnitCode: createdRecord.baseCode || createdRecord.baseUnitCode || normalizedCode,
            baseUnitName: createdRecord.baseName || createdRecord.baseUnitName || normalizedName,
            baseUnitType: 'BASE',
            parentBaseUnitId: 'EOD-HQ-ABUJA',
            state: 'NIGERIA',
            status: 'ACTIVE'
          };

          if (!basesUnits.some(b => normalizeBaseCode(b.baseUnitCode) === normalizedCode)) {
            basesUnits.push(newBaseObj);
          }

          const badgeCount = document.getElementById('badge-count-bases');
          if (badgeCount) badgeCount.textContent = basesUnits.length;

          populateBaseDropdowns();
          logAuditEvent('ADD_BASE', 'BASE', newBaseObj.baseUnitId, 'Base added successfully: ' + normalizedCode + ' - ' + normalizedName);
          
          alert("Base added successfully.");
          codeInput.value = '';
          nameInput.value = '';
          closeAddBaseModal();
        } else if (response.status === 409) {
          const msg = (data && data.message) ? data.message : `Base Code ${normalizedCode} already exists.`;
          if (errBanner) { errBanner.textContent = msg; errBanner.classList.remove('hidden'); }
          codeInput.classList.add('border-rose-500');
        } else if (response.status === 403) {
          const msg = 'You do not have permission to add a base.';
          if (errBanner) { errBanner.textContent = msg; errBanner.classList.remove('hidden'); }
        } else if (response.status === 400) {
          const msg = (data && data.message) ? data.message : 'Base Code and Base Name are required.';
          if (errBanner) { errBanner.textContent = msg; errBanner.classList.remove('hidden'); }
        } else {
          const msg = (data && data.message) ? data.message : 'The base could not be saved. Please contact the system administrator.';
          if (errBanner) { errBanner.textContent = msg; errBanner.classList.remove('hidden'); }
        }

      } catch (err) {
        console.warn('[FRONTEND FETCH WARNING] Backend endpoint offline/unreachable, saving base locally:', err);
        const exists = basesUnits.some(b => normalizeBaseCode(b.baseUnitCode) === normalizedCode);
        if (exists) {
          if (errBanner) { errBanner.textContent = `Base Code ${normalizedCode} already exists.`; errBanner.classList.remove('hidden'); }
          codeInput.classList.add('border-rose-500');
        } else {
          const localBase = {
            baseUnitId: 'EOD-BASE-' + Date.now(),
            baseUnitCode: normalizedCode,
            baseUnitName: normalizedName,
            baseUnitType: 'BASE',
            parentBaseUnitId: 'EOD-HQ-ABUJA',
            state: 'NIGERIA',
            status: 'ACTIVE'
          };
          basesUnits.push(localBase);
          const badgeCount = document.getElementById('badge-count-bases');
          if (badgeCount) badgeCount.textContent = basesUnits.length;

          populateBaseDropdowns();
          logAuditEvent('ADD_BASE', 'BASE', localBase.baseUnitId, 'Base added successfully: ' + normalizedCode + ' - ' + normalizedName);
          alert("Base added successfully.");
          codeInput.value = '';
          nameInput.value = '';
          closeAddBaseModal();
        }
      } finally {
        submitBtn.disabled = false;
        submitBtnText.textContent = 'SAVE BASE';
      }
    }

    function toggleBaseStatus(baseId) {
      const base = basesUnits.find(b => b.baseUnitId === baseId);
      if (!base) return;

      const assignedCount = dbPersonnel.filter(p => p.currentBaseUnitId === baseId).length;
      if (assignedCount > 0 && base.status === 'ACTIVE') {
        if (!confirm(`This base has ${assignedCount} assigned personnel. Deactivating it will not delete personnel records. Proceed with deactivation?`)) {
          return;
        }
      }

      base.status = base.status === 'ACTIVE' ? 'INACTIVE' : 'ACTIVE';
      logAuditEvent('TOGGLE_BASE_STATUS', 'BASE', baseId, `Toggled base status to ${base.status}`);
      alert(`Base ${base.baseUnitCode} is now ${base.status}.`);
      populateBaseDropdowns();
      if (currentView === 'BASES_VIEW') renderModule();
    }

    window.handleAddBaseSubmit = handleAddBaseSubmit;
    window.openAddUnitModal = openAddUnitModal;
    window.closeAddUnitModal = closeAddUnitModal;
    window.confirmCloseAddUnitModal = confirmCloseAddUnitModal;
    async function handleAddUnitSubmit(e) {
      if (e) e.preventDefault();

      const unitCode = document.getElementById('unit-code') ? document.getElementById('unit-code').value.trim() : '';
      const unitName = document.getElementById('unit-name') ? document.getElementById('unit-name').value.trim() : '';
      const baseId = document.getElementById('unit-base-id') ? document.getElementById('unit-base-id').value : '';
      const description = document.getElementById('unit-description') ? document.getElementById('unit-description').value.trim() : '';

      if (!unitCode || !unitName || !baseId) {
        alert('Unit Code, Unit Name, and Parent Base are required.');
        return;
      }

      const submitBtn = document.getElementById('btn-submit-unit');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/units', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-user-role': currentUserRole || 'GLOBAL_ADMIN' },
          body: JSON.stringify({ unitCode, unitName, baseId, description })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('Unit added successfully!');
          if (typeof fetchUnitsFromAPI === 'function') await fetchUnitsFromAPI();
          if (typeof closeAddUnitModal === 'function') closeAddUnitModal();
          if (e.target && typeof e.target.reset === 'function') e.target.reset();
        } else {
          alert('Error adding unit: ' + (data.message || 'Failed to save unit.'));
        }
      } catch (err) {
        console.error('Add Unit API Exception:', err);
        alert('Network error saving unit to database.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    window.handleAddUnitSubmit = handleAddUnitSubmit;
    window.filterUnitsBySelectedBase = filterUnitsBySelectedBase;
    window.confirmCloseAddBaseModal = confirmCloseAddBaseModal;
    window.toggleBaseStatus = toggleBaseStatus;
    window.normalizeBaseCode = normalizeBaseCode;


    window.switchView = switchView;
    window.changeUserRole = changeUserRole;
    window.openAddPersonnelModal = openAddPersonnelModal;
    window.closeAddPersonnelModal = closeAddPersonnelModal;
    window.openReconciliationModal = openReconciliationModal;
    window.closeReconciliationModal = closeReconciliationModal;
    window.handleAddPersonnelSubmit = handleAddPersonnelSubmit;
    window.rollbackApapaMasterRollReplacement = rollbackApapaMasterRollReplacement;
    window.openPersonnelLoginModal = openPersonnelLoginModal;
    window.closePersonnelLoginModal = closePersonnelLoginModal;
    window.openPersonnelRegisterModal = openPersonnelRegisterModal;
    window.closePersonnelRegisterModal = closePersonnelRegisterModal;

    document.addEventListener('DOMContentLoaded', () => {
      archivedMasterRolls.push(JSON.parse(JSON.stringify(INITIAL_APAPA_PERSONNEL)));
      populateBaseDropdowns();
      changeUserRole('GLOBAL_ADMIN');
      fetchPersonnelFromAPI();
      fetchBasesFromAPI();
      fetchUnitsFromAPI();
    });
  </script>
</body>
</html>
