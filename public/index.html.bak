  </div>

  <!-- JAVASCRIPT ENGINE -->
  <script>
    const INITIAL_APAPA_PERSONNEL = [
  {
    "id": "POL-APAPA-001",
    "personnelId": "POL-APAPA-001",
    "apNo": "117369",
    "serviceNo": "117369",
    "rank": "CSP",
    "name": "DESMOND AGBALA",
    "eduQual": "BSC POLICE SCIENCE",
    "stateOfOrigin": "FCT",
    "lga": "ABJ MUNICIPAL",
    "phone": "08034268620",
    "tribe": "OMAH",
    "dob": "1976-12-22",
    "geoPolZone": "NORTH CENTRAL",
    "lastPromDate": "1999-12-01",
    "retireDate": "2035-01-01",
    "commandServedLast": "Apapa Sea Port EOD-CBRN Tactical Base",
    "dutyPost": "BASE COMMANDER",
    "transferredDate": "2023-01-01",
