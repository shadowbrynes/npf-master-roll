{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/register",
      "destination": "/api/register.js"
    },
    {
      "source": "/api/profile",
      "destination": "/api/profile.js"
    },
    {
      "source": "/api/bases",
      "destination": "/api/bases.js"
    },
    {
      "source": "/api/personnel",
      "destination": "/api/personnel.js"
    },
    {
      "source": "/api/units",
      "destination": "/api/units.js"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api/dashboard.js"
    },
    {
      "source": "/api/retirement-projections",
      "destination": "/api/retirement-projections.js"
    },
    {
      "source": "/api/migrate",
      "destination": "/api/migrate.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}